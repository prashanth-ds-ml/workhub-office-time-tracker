{
  "builds": [
    {
      "src": "web_app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/", "destination": "/web_app/index.html" },
    { "source": "/(.*)", "destination": "/web_app/$1" }
  ]
}
