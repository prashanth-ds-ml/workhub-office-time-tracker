WORKHUB_ENV=production
POSTGRES_URL=postgresql://workhub_user:CHANGE_ME@ep-example-000000.us-east-1.aws.neon.tech/workhub?sslmode=require
WORKHUB_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
WORKHUB_JWT_EXPIRE_HOURS=12
WORKHUB_BOOTSTRAP_SECRET=REPLACE_WITH_A_ONE_TIME_COMPANY_SETUP_CODE
WORKHUB_ALLOW_SELF_REGISTRATION=true
WORKHUB_PASSWORD_RESET_MINUTES=30
WORKHUB_SMTP_HOST=smtp.example.com
WORKHUB_SMTP_PORT=587
WORKHUB_SMTP_TLS=true
WORKHUB_SMTP_USER=notifications@example.com
WORKHUB_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
WORKHUB_SMTP_FROM=WorkHub <notifications@example.com>
